# Copy this file to .env and fill in your values. .env is gitignored.

# Free API key for USDA NASS Quick Stats (layer flock, egg production, and
# egg price data). Sign up in about a minute at:
#   https://quickstats.nass.usda.gov/api
# The key is emailed to you immediately, no approval wait.
NASS_API_KEY=

# Optional: port for the Express server (defaults to 3000).
# PORT=3000
